# Скопіюйте цей файл у .env і заповніть потрібне

# Порт сайту
PORT=3000

# Нова Пошта: ключ з особистого кабінету business.novaposhta.ua → Налаштування → Безпека.
# Пошук міст і відділень працює і без ключа, але з ключем стабільніше.
NP_API_KEY=

# Укрпошта: відділення беруться з відкритих даних data.gov.ua і синхронізуються автоматично.
# Як часто перевіряти наявність нового файлу (днів):
UP_SYNC_DAYS=7
# Необов'язково: токен онлайн-класифікатора Укрпошти (за договором, dev.ukrposhta.ua) — тоді він замінить відкриті дані.
UKRPOSHTA_TOKEN=

# Пошта для кодів підтвердження (реєстрація, зміна пароля).
# Без цих налаштувань коди виводяться в консоль сервера (лише для розробки!).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=ваша@gmail.com,
#        SMTP_PASS=пароль застосунку (myaccount.google.com → Безпека → Паролі застосунків)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ягідник <ваша@gmail.com>"

# Коди підтвердження додатково у Viber (якщо покупець вказав телефон) — через TurboSMS
# Кабінет turbosms.ua → Налаштування API → «HTTP API» → ключ; відправника Viber активувати в кабінеті
TURBOSMS_TOKEN=
TURBOSMS_VIBER_SENDER=
# Необов'язково: якщо Viber у покупця немає — надіслати той самий код звичайним SMS (альфа-ім'я з кабінету)
TURBOSMS_SMS_SENDER=

# Онлайн-оплата карткою — інтернет-еквайринг monobank (plata by mono)
# Бойовий токен: https://web.monobank.ua/ → Еквайринг → Токен.  Тестовий (гроші не списуються): https://api.monobank.ua/
MONO_TOKEN=
# 1 — показувати на сайті «тестовий режим» (лише з тестовим токеном). Для реальних оплат — 0 або прибрати
MONO_TEST=1

# Публічна адреса сайту (https://ваш-домен.ua) — для повернення з оплати monobank і вебхуків про оплату.
# Локально можна не заповнювати: статус оплати перевіряється запитом до monobank.
SITE_URL=
