# Тимчасовий варіант БЕЗ домену: сайт відкривається за http://IP_СЕРВЕРА (без HTTPS — лише для демонстрації).
# Коли купите домен — замініть /etc/caddy/Caddyfile на deploy/Caddyfile.
:80 {
	encode gzip zstd
	request_body {
		max_size 45MB
	}
	reverse_proxy 127.0.0.1:3000
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
}
