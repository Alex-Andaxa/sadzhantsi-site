# Caddy — веб-сервер перед сайтом: сам отримує й оновлює HTTPS-сертифікат (Let's Encrypt).
# Встановлення: cp deploy/Caddyfile /etc/caddy/Caddyfile && systemctl reload caddy
yahidnyk.com {
	encode gzip zstd
	# Фото лотів: великі запити дозволені лише адмінці (до 40 МБ — до 5 фото)
	request_body {
		max_size 45MB
	}
	reverse_proxy 127.0.0.1:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
}

# www.yahidnyk.com → yahidnyk.com
www.yahidnyk.com {
	redir https://yahidnyk.com{uri} permanent
}

# Звернення за IP → на домен
http://178.95.255.10 {
	redir https://yahidnyk.com{uri} permanent
}
